{
  "name": "@529studio/lore",
  "version": "0.5.0",
  "description": "Git for what your AI agents know — versioned, verifiable, mergeable memory for multi-agent coding.",
  "type": "module",
  "bin": {
    "lore": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "templates"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "bash scripts/smoke.sh",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "mcp:concurrency": "node scripts/mcp-concurrency.mjs",
    "canon:smoke": "node scripts/canon-smoke.mjs",
    "pg:smoke": "node scripts/pg-sync.mjs",
    "ui:smoke": "node scripts/ui-smoke.mjs",
    "setup:smoke": "node scripts/setup-smoke.mjs",
    "eval": "node scripts/eval.mjs",
    "demo:cli": "node scripts/demo/record-cli.mjs",
    "docs:lint": "node scripts/docs-lint.mjs",
    "check:public": "bash scripts/check-public-safe.sh",
    "prepublishOnly": "npm run build && npm run smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/529-studio/lore.git"
  },
  "homepage": "https://github.com/529-studio/lore#readme",
  "bugs": {
    "url": "https://github.com/529-studio/lore/issues"
  },
  "keywords": [
    "agent-memory",
    "mcp",
    "multi-agent",
    "ai-agents",
    "git-for-memory",
    "claude-code",
    "codex",
    "memory"
  ],
  "author": "529 Studio",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "commander": "^15.1.0",
    "pg": "^8.23.1",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
